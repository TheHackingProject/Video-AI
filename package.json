{
  "name": "Video-AI",
  "private": true,
  "scripts": {
    "bootstrap:agents": "bash scripts/bootstrap-agent-tooling.sh",
    "env:init": "sh -c 'if [ ! -f .env ]; then cp .env.example .env && echo \"Created .env from .env.example\"; else echo \".env already exists — not overwritten\"; fi'",
    "build": "turbo run build",
    "build-storybook": "turbo run build-storybook --filter=storybook",
    "dev": "turbo run dev",
    "trigger:dev": "turbo run dev --filter=trigger",
    "storybook": "turbo run storybook --filter=storybook",
    "remotion": "turbo run remotion --filter=remotion",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "prettier": "^3.7.4",
    "turbo": "^2.8.15",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
