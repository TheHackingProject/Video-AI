# Video-AI — local development (self-host Trigger only; no Trigger.dev Cloud)
#
# Setup:
#   cp .env.example .env
#   # or: bun run env:init
#
# Bun loads `.env` from the repo root when you run `bun run dev` here.
# Turbo forwards these vars to tasks (see turbo.json `globalEnv`).

# --- PostgreSQL (@repo/db, API) — see KM/Docs/runbooks/postgres-local.md ---
DATABASE_URL=postgres://video_ai:video_ai@localhost:5432/video_ai_dev

# --- API (apps/api) ---
NODE_ENV=development
PORT=8787
CORS_ORIGIN=http://localhost:5173

# --- Frontend (apps/frontend) ---
VITE_API_BASE_URL=http://localhost:8787

# --- Trigger.dev — self-hosted instance only (required for POST /jobs/render-pipeline) ---
# Upstream local default in docs: http://localhost:8030
TRIGGER_API_URL=http://localhost:8030
# API secret from your Trigger webapp (Project settings)
TRIGGER_SECRET_KEY=
# Used by apps/trigger (trigger.config.ts) for `bun run dev` / deploy
TRIGGER_PROJECT_REF=proj_REPLACE_ME

# --- Optional: CI deploy of tasks (see Trigger GitHub Actions docs) ---
# TRIGGER_ACCESS_TOKEN=
