  "dependencies": {
    "@repo/contracts": "*",
    "drizzle-orm": "^0.44.5",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@types/node": "^24.5.2",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.39.1",
    "typescript": "^5.9.2"
  }
