# Prefer repo root `.env.example` → copy to `Video-AI/.env` for `bun run dev` (Turbo).
# If you run the API alone from this directory, copy this file to `apps/api/.env`
# or symlink: ln -s ../../.env .env

DATABASE_URL=postgres://video_ai:video_ai@localhost:5432/video_ai_dev
NODE_ENV=development
PORT=8787
CORS_ORIGIN=http://localhost:5173

# Trigger (self-host only) — required together for POST /jobs/render-pipeline
TRIGGER_API_URL=http://localhost:8030
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=proj_REPLACE_ME
